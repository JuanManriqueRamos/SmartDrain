# Copia este archivo como .env y completa los valores.
DISCORD_WEBHOOK_URL=
API_TOKEN=CONFIGURAR_TOKEN_ALEATORIO_LARGO
DB_HOST=localhost
DB_NAME=nodo_sensor
DB_USER=CONFIGURAR_USUARIO_DB
DB_PASSWORD=CONFIGURAR_PASSWORD_DB
DASHBOARD_USER=CONFIGURAR_USUARIO_PANEL
DASHBOARD_PASSWORD=CONFIGURAR_PASSWORD_PANEL

# --- Opcionales (valores por defecto) ---
# Segundos sin tramas para avisar "SENSOR SIN REPORTAR" en Discord
SENSOR_OFFLINE_SECONDS=120
# Cada cuántos segundos se revisa
WATCHDOG_INTERVAL_SECONDS=30
# Aviso cuando el HX710B deja de entregar lectura (1 = sí, 0 = no)
ALERT_HX710B_MISSING=1
# Tramas seguidas en el nuevo estado antes de avisar (evita avisos repetidos)
HX710B_CONFIRM_READINGS=3
